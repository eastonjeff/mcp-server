{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch MCP server",
            "type": "debugpy",
            "request": "launch",
            "module": "mcp_server.server",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Launch MCP Inspector",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\scripts\\launch_inspector.py",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Run tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-q"
            ],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
