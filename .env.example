# PostgreSQL connection string for the existing database.
DATABASE_URL=postgresql://user:password@localhost:5432/database_name
# Seconds to wait before reporting that PostgreSQL cannot be reached.
DB_CONNECT_TIMEOUT=5
# OpenAI-compatible endpoint. Ollama uses this default when running locally.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:3b
# Optional for hosted OpenAI-compatible endpoints.
LLM_API_KEY=
LLM_TIMEOUT=60
